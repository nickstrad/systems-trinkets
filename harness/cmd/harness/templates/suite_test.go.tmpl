// TestMain opens the results sink for the run and closes it at exit. Once a
// Go reference implementation exists, pass harness.InProcess(func() http.Handler
// { … }) so `go test ./...` runs this suite against it instead of skipping.
func TestMain(m *testing.M) { os.Exit(harness.Main(m)) }

// TestContract walks the sequential contract (kind 1). harness.New has already
// reset the SUT and confirmed /healthz; add the pattern's own steps, one
// check.Invariant per INVARIANTS.md row they probe.
func TestContract(t *testing.T) {
	h := harness.New(t)

	// TODO: replace with the first real step of CONTRACT.md.
	resp := h.Must(h.Get("/healthz", nil, nil))
	check.Invariant(h, "INV-{{.InvPrefix}}-01", resp.Status == http.StatusOK,
		"TODO: the guide-row invariant, stated as a check", map[string]any{"status": resp.Status})
}

// TestConcurrent is the kind-2 shape: N workers released on a barrier, then
// the invariant is checked on the final state — never on timing.
func TestConcurrent(t *testing.T) {
	h := harness.New(t)
	const workers, perWorker = 32, 100

	r := load.Closed(h, workers, perWorker, func(w *load.Worker) error {
		// TODO: one write per iteration through h.Client with w.Ctx, e.g.
		// _, err := h.Client.Post(w.Ctx, "/{{.Pattern}}/{id}", map[string]string{"id": "hot"}, nil, nil)
		_, err := h.Client.Get(w.Ctx, "/healthz", nil, nil)
		return err
	})
	if r.Elapsed > 0 {
		check.Metric(h, "throughput", float64(r.Total)/r.Elapsed.Seconds(), "req/s", map[string]any{"workers": workers})
	}
	if !r.Conclusive(h) {
		return
	}

	// TODO: read the final state and compare it with what the 2xx requests imply.
	check.Invariant(h, "INV-{{.InvPrefix}}-01", r.OK2xx == r.Total,
		"TODO: final state equals what the 2xx requests imply", map[string]any{"ok": r.OK2xx, "total": r.Total})
}
